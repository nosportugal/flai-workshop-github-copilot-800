{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Express Backend",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/octofit-tracker/backend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "env": {
                "PORT": "8000"
            },
            "outputCapture": "std"
        },
        {
            "name": "Launch Vite Frontend",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/octofit-tracker/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev",
                "--",
                "--host",
                "0.0.0.0"
            ],
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:",
                "uriFormat": "http://localhost:5173"
            },
            "outputCapture": "std"
        }
    ],
    "compounds": [
        {
            "name": "Launch OctoFit Tracker (Backend + Frontend)",
            "configurations": [
                "Launch Express Backend",
                "Launch Vite Frontend"
            ],
            "presentation": {
                "hidden": false,
                "group": "",
                "order": 1
            },
            "stopAll": true
        }
    ]
}
